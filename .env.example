# Copy to .env and fill in the blank values. See README.md for details.

# SQLite database path (resolved relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# NextAuth session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# App base URL.
AUTH_URL="http://localhost:3000"

# Token the n8n agent sends as the x-internal-token header to
# /api/activation-debug. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_API_TOKEN=""

# Optional. Only needed to run `npm run eval` (the LLM eval harness) — the
# n8n rescue agent uses its own OpenAI credential, not this one.
OPENAI_API_KEY=""
